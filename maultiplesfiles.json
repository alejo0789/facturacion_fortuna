                "jsCode": "const fecha = new Date();\n\nconst mesTexto = fecha.toLocaleString('es-CO', { month: 'long' });\nconst dia = fecha.getDate();\nconst anio = fecha.getFullYear(); // Agregamos esta línea\n\nreturn {\n  mes: mesTexto,\n  dia,\n  anio // Lo agregamos al objeto de retorno\n};"
