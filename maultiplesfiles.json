        {
            "parameters": {
                "jsCode": "const output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  for (const key of Object.keys(item.binary || {})) {\n    const bin = item.binary[key];\n    const fileName = bin.fileName?.toLowerCase() || '';\n\n    if (bin.mimeType === 'application/pdf' || fileName.endsWith('.pdf')) {\n      output.push({\n        json: { fileName: bin.fileName || 'archivo.pdf' },\n        binary: { data: bin },\n        pairedItem: { item: i }\n      });\n    }\n  }\n}\n\nreturn output;"
            },
