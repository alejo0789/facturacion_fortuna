# Project Specific
# ===========================

# Temporary Excel files
~$*.xlsx
~$*.xls

# Database files (if using SQLite locally)
*.db
*.sqlite
*.sqlite3

# Uploaded files / temp storage
uploads/
temp/

# PDF contracts (may contain sensitive data)
# Uncomment if you want to exclude uploaded contract PDFs
# backend/contratos_pdf/

# Large documentation files (exclude if too large for repo)
# Uncomment next line to exclude the dictionary PDF
# *.pdf

# ===========================
# Sensitive / Secret Files
# ===========================

# Secret keys
*.pem
*.key
secrets.json
config.local.json

# API keys / credentials
credentials.json
service-account.json

# Oracle Snapshot DB (Too large for Git)
backend/oracle_snapshot.sql

# Database dumps locales (NUNCA al repo — datos sensibles)
backup_db/
*.dump

# User request: exclude from github but keep local
*.pdf
*.md
*.sql

# Excepciones — archivos del proyecto que SÍ deben ir al repo (rama saas-multitenant)
!README.md
!DEPLOYMENT_LOCAL.md
!SETUP_N8N.md
!n8n/README_INTEGRACION.md
!backend/migrations/*.sql
# NOTA: backend/.env.example y frontend/.env.production se SACARON del repo
