      "name": "Descomprimir ZIP",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1,
      "position": [
        1312,
        592
      ],
      "id": "56b995d2-53d3-4f56-8c9a-9478860d2079"
    },
    {
      "parameters": {
        "functionCode": "const pdfs = [];\n\nfor (const item of items) {\n  if (!item.binary) continue;\n\n  // Propagate parent metadata if available, otherwise just use filename\n  // The Compression node preserves input JSON, so we can use it.\n  const messageId = item.json.sourceId;\n  const receivedDate = item.json.date;\n  const sender = item.json.sender;\n  const requestId = item.json.requestId;\n\n  for (const key of Object.keys(item.binary)) {\n    const f = item.binary[key];\n    if (f.fileName.toLowerCase().endsWith('.pdf')) {\n      pdfs.push({\n        json: {\n          filename: f.fileName,\n          size: f.fileSize ? parseInt(f.fileSize) : 0,\n          type: f.mimeType,\n          sourceId: messageId,\n          date: receivedDate,\n          sender: sender,\n          requestId: requestId\n        },\n        // We don't strictly need to pass binary here if we are just listing, \n        // but keeping it is good practice for testing\n        binary: { data: f }\n      });\n    }\n  }\n}\n\nreturn pdfs;"
      },
