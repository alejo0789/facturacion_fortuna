        "returnAll": true,
        "output": "raw",
        "filtersUI": {
          "values": {
            "filters": {
              "receivedAfter": "={{$json.body.startDate}}",
              "receivedBefore": "={{$json.body.endDate}}",
              "sender": "={{$json.body.email}}"
            }
