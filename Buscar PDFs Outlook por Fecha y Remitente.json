      "name": "Buscar Correos Outlook",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        640,
        656
      ],
      "id": "a2bc5351-a448-4d0b-8a95-524462614896",
      "webhookId": "5520b7fb-4e47-48e0-aefb-2a06ac3f7c31"
    },
    {
      "parameters": {
        "functionCode": "const out = [];\n\nfor (const item of items) {\n  if (!item.binary) continue;\n\n  // Preserve metadata from the email\n  const messageId = item.json.id;\n  const receivedDate = item.json.receivedDateTime;\n  const sender = item.json.from ? item.json.from.emailAddress.address : '';\n\n  for (const key of Object.keys(item.binary)) {\n    const f = item.binary[key];\n    const name = f.fileName.toLowerCase();\n\n    if (name.endsWith('.pdf') || name.endsWith('.zip')) {\n      out.push({\n        json: {\n          filename: f.fileName,\n          size: f.fileSize ? parseInt(f.fileSize) : 0,\n          type: f.mimeType,\n          sourceId: messageId,\n          date: receivedDate,\n          sender: sender,\n          isZip: name.endsWith('.zip'),\n          requestId: $json.body.requestId // Pass requestId through\n        },\n        binary: { data: f }\n      });\n    }\n  }\n}\n\nreturn out;"
      },
      "name": "Filtrar PDF y ZIP",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
